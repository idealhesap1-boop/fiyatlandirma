{
    "name": "cse/component-product",
    "version": "1.2",
    "description": "Component Based Product Module for OpenCart 4",
    "type": "opencart-extension",
    "authors": [
        {
            "name": "CSE Senior Dev Team",
            "email": "support@example.com"
        }
    ],
    "require": {
        "opencart/opencart": ">=4.0.0.0"
    },
    "autoload": {
        "psr-4": {
            "Opencart\\Catalog\\Controller\\Extension\\ComponentProduct\\": "catalog/controller/extension/component_product/",
            "Opencart\\Catalog\\Model\\Extension\\ComponentProduct\\": "catalog/model/extension/component_product/",
            "Opencart\\Catalog\\Model\\Extension\\Total\\": "catalog/model/extension/total/"
        }
    }
}
